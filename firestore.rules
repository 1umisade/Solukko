rules_version = '2';
// Solukko Firestore security rules.
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.
// Requires Anonymous sign-in enabled (Authentication -> Sign-in method -> Anonymous).
//
// NOTE ON "dev"/admin powers: there is no server, so we can't mint custom claims.
// To let YOU (the dev) moderate any comment or control the quiz, paste your own
// anonymous uid into isAdmin() below (get it from Authentication -> Users, or run
// `firebase.auth().currentUser.uid` in the site console while signed in).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function str(v, max) { return v is string && v.size() <= max; }
    // Fill in your uid(s) to unlock dev moderation / quiz control:
    function isAdmin() { return signedIn() && request.auth.uid in ['PASTE_YOUR_DEV_UID']; }

    // ── Comments (card comments + replies) ──
    match /comments/{id} {
      allow read: if true;                                             // comments are public
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid    // can only post as yourself
                    && str(request.resource.data.text, 2000)
                    && str(request.resource.data.cardId, 200)
                    && !('golden' in request.resource.data)                // users can't self-award the gold prize...
                    && !('goldenCode' in request.resource.data)            // ...only the dev (admin) can, via update
                    && (!('imageData' in request.resource.data)
                        || (request.resource.data.imageData is string
                            && request.resource.data.imageData.size() <= 900000));   // ~0.9 MB cap
      // author can edit their own text/image but NOT the gold status; only the dev paints a comment gold
      allow update: if isAdmin()
                    || ( isOwner(resource.data.userId)
                         && request.resource.data.get('golden', false) == resource.data.get('golden', false)
                         && request.resource.data.get('goldenCode', '') == resource.data.get('goldenCode', '') );
      allow delete: if isOwner(resource.data.userId) || isAdmin();        // author (or dev) only
    }

    // ── Prizes (the golden-comment claim code); doc id == comment id ──
    // The code is PRIVATE: only the winner (owner) and the dev can read it, so
    // nobody can read someone else's code and claim their prize. Only the dev writes.
    match /prizes/{id} {
      allow read:  if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── Presence (online users); doc id == uid ──
    match /presence/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if true;   // ephemeral; also removed via unauthenticated REST cleanup
    }

    // ── Live quiz: current card / owner, buzzers, team money, volunteers ──
    // Best-effort without admin auth: signed-in + validated. Lock to the dev by
    // switching the writes to `if isAdmin()` once you've filled in your uid above.
    match /gamestate/{doc} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /buzzers/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && str(request.resource.data.word, 100);
      allow delete: if signedIn();
    }
    match /joukkueet/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /kuvaajat/{id} {
      allow read: if true;
      allow create: if signedIn() && str(request.resource.data.word, 200);
      allow update, delete: if signedIn();
    }

    // ── User-added cards (students' own flashcards added to a deck) ──
    // Visible only to the creator's device (owner) and the dev (admin). A normal user
    // must query with where('userId','==', their uid); the dev may read a whole deck.
    match /userCards/{id} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid   // can only add as yourself
                    && str(request.resource.data.deck, 300)
                    && str(request.resource.data.front, 4000)
                    && str(request.resource.data.back, 4000)
                    && !('approved' in request.resource.data)             // can't self-award on create...
                    && !('approvedCode' in request.resource.data)
                    && !('paid' in request.resource.data);
      // Owner may edit their card and flag it `suggested`; only the dev (admin) may set approved / approvedCode / paid.
      allow update: if (isOwner(resource.data.userId) || isAdmin())
                    && request.resource.data.userId == resource.data.userId   // owner can't be reassigned
                    && str(request.resource.data.front, 4000)
                    && str(request.resource.data.back, 4000)
                    && ( isAdmin() || (
                           request.resource.data.get('approved', false) == resource.data.get('approved', false)
                        && request.resource.data.get('approvedCode', '') == resource.data.get('approvedCode', '')
                        && request.resource.data.get('paid', false) == resource.data.get('paid', false)
                    ) );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Everything else is denied.
    match /{document=**} { allow read, write: if false; }
  }
}
